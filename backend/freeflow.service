[Unit]
Description=Freeflow Backend (FastAPI SSH Proxy + Web UI)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/freeflowonelinerrebuildvps/backend
ExecStart=/root/freeflowonelinerrebuildvps/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
